# 1) Pull in standalone Swagger UI assets
FROM swaggerapi/swagger-ui:v4.18.2 AS swagger-ui

# 2) Base image: CUDA 11.8 on Ubuntu 22.04
FROM nvidia/cuda:12.6.0-base-ubuntu22.04
# 3) Environment & pyenv bootstrap
ENV PYTHON_VERSION=3.12.0
ENV PYENV_ROOT=/root/.pyenv
ENV PATH="$PYENV_ROOT/bin:$PYENV_ROOT/shims:$PATH"

# In-project Poetry venv & placeholder for GCP creds
ENV POETRY_VENV=/app/.venv
ENV GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa.json

# ASR_MODEL / ASR_ENGINE. Defaults match the deployed config (faster_whisper /
# medium.en — see infrastructure/whisper/templates/whisper-deployment.yaml) so
# the build-time model pre-bake below (AMLG-13280) bakes the model the pods
# actually run. codefresh.yaml also passes these as build-args; keep the three
# in sync — a mismatch silently reverts to a runtime download.
ARG ASR_MODEL=medium.en
ARG ASR_ENGINE=faster_whisper
ENV ASR_MODEL=${ASR_MODEL}
ENV ASR_ENGINE=${ASR_ENGINE}

ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# 4) Install build deps + ffmpeg
# The --only-upgrade line pulls patched OS packages from the refreshed Ubuntu
# lists: openssl (3.0.2-0ubuntu1.17 -> 3.0.2-0ubuntu1.25, CVE-2026-45447 /
# AMLG-13278) and gnupg2 (CVE-2025-68973 / AMLG-13279). The gpg *binaries* are
# already patched at 2.2.27-3ubuntu2.5; the gnupg2 transitional dummy package
# lagged at 2.1, so it's named explicitly here to pull it forward.
#
# We deliberately do NOT install python3-pip: it's the Ubuntu *system* Python
# (3.10) pip, which we never use (the app runs on the pyenv 3.12 interpreter +
# Poetry). It drags in python3-setuptools and the bundled wheels under
# /usr/share/python-wheels/, whose stale setuptools/wheel/jaraco.context copies
# the image scanner flags for High CVEs (CVE-2025-47273, CVE-2024-6345,
# CVE-2026-24049, CVE-2026-23949 / AMLG-13279). The purge line removes them if
# the base image or a transitive dep pulled them in anyway.
RUN apt-get update -qq && \
    apt-get install -qq --no-install-recommends \
      build-essential curl git \
      libbz2-dev libffi-dev libreadline-dev libsqlite3-dev libssl-dev \
      liblzma-dev libncurses5-dev libncursesw5-dev uuid-dev tk-dev \
      xz-utils zlib1g-dev ffmpeg && \
    apt-get install -qq --no-install-recommends --only-upgrade \
      openssl libssl3 libssl-dev gpgv gnupg gnupg2 dirmngr && \
    apt-get purge -qq -y python3-pip python3-setuptools python3-wheel && \
    apt-get autoremove -qq -y && \
    rm -rf /var/lib/apt/lists/*

# 5) Install pyenv & compile Python 3.12
RUN git clone https://github.com/pyenv/pyenv.git $PYENV_ROOT
RUN export PATH="$PYENV_ROOT/bin:$PATH" && \
    pyenv install ${PYTHON_VERSION} && \
    pyenv global   ${PYTHON_VERSION} && \
    pyenv rehash

# Symlink shims so /usr/bin/python3→3.12
RUN ln -sfn "$(pyenv which python)"  /usr/bin/python && \
    ln -sfn "$(pyenv which python3)" /usr/bin/python3 && \
    ln -sfn "$(pyenv which pip)"     /usr/bin/pip

# 5b) Upgrade the pyenv base-Python build tools (AMLG-13279).
# The freshly compiled CPython ships older setuptools/wheel that the image
# scanner flags for High CVEs (CVE-2024-6345, CVE-2025-47273) — the Poetry venv
# was already bumped (AMLG-13250) but this interpreter, which lives outside it,
# was not. Same floors as the venv (step 6); keep the <81 setuptools cap from
# AMLG-13204.
RUN pip install --upgrade pip "setuptools>=78.1.1,<81" "wheel>=0.46.2"

# 6) Create venv & install Poetry 2.3.3
RUN python3 -m venv $POETRY_VENV && \
    $POETRY_VENV/bin/pip install -U pip "setuptools>=78.1.1,<81" "wheel>=0.46.2" && \
    $POETRY_VENV/bin/pip install poetry==2.3.3

ENV PATH="${PATH}:${POETRY_VENV}/bin"
WORKDIR /app

# 7) Install deps (without your own code yet)
# --only main excludes the dev/test groups (pytest, moviepy, google-cloud-storage)
# from the runtime image — they are not needed to serve and dropping them removes
# a large block of image CVEs (AMLG-13250).
COPY poetry.lock pyproject.toml ./
RUN poetry config virtualenvs.in-project true && \
    poetry install --only main --no-root

# 8) Copy your app + swagger assets
COPY . .
COPY --from=swagger-ui /usr/share/nginx/html/swagger-ui.css    swagger-ui-assets/swagger-ui.css
COPY --from=swagger-ui /usr/share/nginx/html/swagger-ui-bundle.js swagger-ui-assets/swagger-ui-bundle.js

# 9) Install your package and GPU PyTorch
RUN poetry install --only main && \
    $POETRY_VENV/bin/pip install --upgrade \
    -f https://download.pytorch.org/whl/cu126/torch_stable.html \
    torch==2.7.1

# 10) Post-install security cleanup (AMLG-13279).
# The last build-tool High CVEs live in *frozen* copies that `pip install -U`
# never rewrites (confirmed by inspecting the built image):
#  - CPython ships packaging test fixtures under lib/python3.12/test/
#    (setuptools 67.6.1 -> CVE-2024-6345/CVE-2025-47273, wheel 0.40.0 ->
#    CVE-2026-24049). The stdlib test suite isn't used at runtime, so drop it.
#  - poetry pins the venv's setuptools to 80.9.0, whose bundled setuptools/_vendor
#    carries wheel 0.45.1 (CVE-2026-24049) + jaraco.context 5.3.0
#    (CVE-2026-23949). Re-bumping to the latest <81 (80.10.2) — which the pyenv
#    base already runs — vendors patched wheel 0.46.3 + jaraco_context 6.1.0.
#    Runs after poetry so it isn't reverted; keeps the <81 cap from AMLG-13204.
RUN rm -rf "$PYENV_ROOT/versions/${PYTHON_VERSION}/lib/python3.12/test" && \
    $POETRY_VENV/bin/pip install --upgrade "setuptools>=80.10.2,<81" && \
    rm -rf /root/.cache/pypoetry /root/.cache/pip

ENV LD_LIBRARY_PATH="/app/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib:$LD_LIBRARY_PATH"

# 11) Pre-bake the ASR model at build time (AMLG-13280).
# app/faster_whisper/core.py loads the pre-converted ctranslate2 model from the
# HF Hub (e.g. medium.en -> Systran/faster-whisper-medium.en) at import — a
# ~1.5GB download on EVERY cold start, which dominated the ~7min start that
# forced the startupProbe (AMLG-13253). Instantiating WhisperModel here downloads
# it into the HF cache at build time, so pods load from disk instead of fetching
# 1.5GB on startup. Runs on CPU (no GPU needed on the build runner); WhisperModel
# raises on any download/load failure, so the build fails loudly on its own.
RUN if [ "$ASR_ENGINE" = "faster_whisper" ]; then \
      $POETRY_VENV/bin/python -c "from faster_whisper import WhisperModel; WhisperModel('${ASR_MODEL}', device='cpu', compute_type='int8')" ; \
    fi

# 12) Entrypoint & default CMD
ENTRYPOINT ["gunicorn", "--bind", "0.0.0.0:9000", "--workers", "1", "--timeout", "0", "app.webservice:app", "-k", "uvicorn.workers.UvicornWorker"]
CMD []
